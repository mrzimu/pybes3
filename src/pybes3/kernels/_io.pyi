from typing import Any

import numpy as np
from numpy.typing import NDArray
from uproot_custom.cpp import IReader

class Bes3TObjArrayReader(IReader):
    def __init__(
        self,
        name: str,
        element_reader: IReader,
    ): ...
    def data(self) -> tuple[NDArray[np.uint32], Any]: ...

class Bes3SymMatrixArrayReader(IReader):
    def __init__(
        self,
        name: str,
        flat_size: int,
        full_dim: int,
    ): ...
    def data(self) -> NDArray[np.float64]: ...

class Bes3CgemClusterColReader(IReader):
    def __init__(self, name: str): ...
    def data(self) -> dict[str, NDArray]: ...

class RawFileReader:
    def __init__(self, path: str): ...
    def read(
        self,
        entry_start: int,
        n_events: int,
        fields: list[str],
        info_tables: dict[str, NDArray],
    ) -> dict: ...
    def build_entry_index(self) -> None: ...
    def index_valid(self) -> int: ...
    def entry_starts(self) -> NDArray[np.int64]: ...
    def entry_stops(self) -> NDArray[np.int64]: ...
    def read_block(self, n_blocks: int) -> NDArray[np.uint32]: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def file_version(self) -> int: ...
    @property
    def file_number(self) -> int: ...
    @property
    def file_date(self) -> int: ...
    @property
    def file_time(self) -> int: ...
    @property
    def file_name(self) -> str: ...
    @property
    def file_tag(self) -> str: ...
    @property
    def run_number(self) -> int: ...
    @property
    def max_events(self) -> int: ...
    @property
    def rec_enable(self) -> int: ...
    @property
    def trigger_type(self) -> int: ...
    @property
    def detector_mask(self) -> int: ...
    @property
    def beam_type(self) -> int: ...
    @property
    def beam_energy(self) -> int: ...
    @property
    def entries(self) -> int: ...
    @property
    def data_start(self) -> int: ...
    @property
    def data_end(self) -> int: ...
    @property
    def size(self) -> int: ...

def read_data(
    data: NDArray[np.uint8],
    offsets: NDArray[np.uint32],
    reader: IReader,
) -> Any: ...
def read_bes_raw(
    data: NDArray[np.uint32],
    fields: list[str],
    info_tables: dict[str, NDArray],
) -> dict: ...
